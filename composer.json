{
  "name": "duncrow-gmbh/captcha-eu",
  "version": "2.0.0",
  "description": "Captcha EU Extension for Contao Open Source CMS",
  "keywords": [
    "contao",
    "captcha-eu",
    "duncrow gmbh"
  ],
  "type": "contao-bundle",
  "homepage": "https://duncrow.com",
  "license": "LGPL-3.0-or-later",
  "authors": [
    {
      "name": "Duncrow GmbH",
      "email": "office@duncrow.com",
      "homepage": "https://duncrow.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "contao/core-bundle": "^5.7 || ^6.0",
    "psr/log": "^3.0",
    "symfony/asset": "^7.4 || ^8.0",
    "symfony/config": "^7.4 || ^8.0",
    "symfony/dependency-injection": "^7.4 || ^8.0",
    "symfony/event-dispatcher": "^7.4 || ^8.0",
    "symfony/http-client": "^7.4 || ^8.0",
    "symfony/http-foundation": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4 || ^8.0",
    "symfony/routing": "^7.4 || ^8.0",
    "symfony/translation-contracts": "^3.5"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "DuncrowGmbh\\CaptchaEu\\": "src/"
    }
  },
  "scripts": {
    "manifest": "@php bin/update-manifest.php"
  },
  "extra": {
    "contao-manager-plugin": "DuncrowGmbh\\CaptchaEu\\ContaoManager\\Plugin"
  }
}
